{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user in the F1 Bugambra system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nombre": { "type": "string" },
        "email": { "type": "string" },
        "rol": { "type": "string", "enum": ["admin", "jeque", "piloto"] },
        "escuderia_id": { "type": "string" },
        "foto_url": { "type": "string" },
        "puntos_piloto": { "type": "number" },
        "rating_piloto": { "type": "number", "description": "Rating from 0 to 99" },
        "precio_compra_split": { "type": "number" },
        "precio_carrera_anterior": { "type": "number" },
        "clausula_actual": { "type": "number" },
        "mantener_actual": { "type": "number" },
        "victorias": { "type": "number" },
        "podios": { "type": "number" },
        "poles": { "type": "number" },
        "dnfs": { "type": "number" },
        "carreras_limpias": { "type": "number" }
      },
      "required": ["uid", "nombre", "email", "rol"]
    },
    "Escuderia": {
      "title": "Escuderia",
      "description": "An F1 team managed by a Jeque.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "presupuesto": { "type": "number" },
        "puntos_constructores": { "type": "number" },
        "poles": { "type": "number" },
        "vueltas_rapidas": { "type": "number" },
        "jeque_id": { "type": "string" }
      },
      "required": ["nombre", "presupuesto", "jeque_id"]
    },
    "Split": {
      "title": "Split",
      "description": "A season split.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" }
      },
      "required": ["nombre"]
    },
    "Circuito": {
      "title": "Circuito",
      "description": "A Grand Prix race in a split.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "completado": { "type": "boolean" },
        "resultados": {
          "type": "array",
          "description": "Array of result objects. Should be handled carefully in rules."
        }
      },
      "required": ["nombre", "completado", "resultados"]
    }
  },
  "firestore": {
    "/usuarios/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of all users."
    },
    "/escuderias/{escuderiaId}": {
      "schema": { "$ref": "#/entities/Escuderia" },
      "description": "Collection of F1 teams."
    },
    "/splits/{splitId}": {
      "schema": { "$ref": "#/entities/Split" },
      "description": "Collection of season splits."
    },
    "/splits/{splitId}/circuitos/{circuitoId}": {
      "schema": { "$ref": "#/entities/Circuito" },
      "description": "Collection of races inside a split."
    }
  }
}
