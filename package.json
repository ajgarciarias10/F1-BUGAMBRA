{
  "name": "f1-bugambra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "corepack npm@10.9.4 run dev:web",
    "start": "corepack npm@10.9.4 run dev:web",
    "dev:web": "corepack npm@10.9.4 --workspace @f1-bugambra/web run dev",
    "dev:api": "corepack npm@10.9.4 --workspace @f1-bugambra/api run dev",
    "build": "corepack npm@10.9.4 --workspace @f1-bugambra/web run build",
    "preview": "corepack npm@10.9.4 --workspace @f1-bugambra/web run preview",
    "typecheck": "corepack npm@10.9.4 --workspaces --if-present run typecheck",
    "test": "corepack npm@10.9.4 --workspace @f1-bugambra/api test",
    "clean": "rm -rf apps/web/dist server.js",
    "lint": "corepack npm@10.9.4 run typecheck"
  }
}
