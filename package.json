{
  "name": "f1-bugambra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "start": "npm run dev:web",
    "dev:web": "npm --workspace @f1-bugambra/web run dev",
    "dev:api": "npm --workspace @f1-bugambra/api run dev",
    "build": "npm --workspace @f1-bugambra/web run build",
    "preview": "npm --workspace @f1-bugambra/web run preview",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm --workspace @f1-bugambra/api test",
    "guard:agents": "node tool/agent-guard.mjs",
    "test:guard": "node --test tool/agent-guard.test.mjs",
    "guardrails:economy": "npm run typecheck --workspace @f1-bugambra/web && npm test --workspace @f1-bugambra/web",
    "clean": "rm -rf apps/web/dist server.js",
    "lint": "npm run typecheck"
  }
}
