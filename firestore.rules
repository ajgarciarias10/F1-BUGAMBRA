rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Collection Group rules for Guest Dashboard public reads
    match /{path=**}/equipos/{teamId} {
      allow read: if true;
    }
    match /{path=**}/pilotos/{pilotId} {
      allow read: if true;
    }
    match /{path=**}/circuitos/{circuitoId} {
      allow read: if true;
    }
    // La portada consulta el roster con collectionGroup para montar la
    // clasificación. Una consulta de grupo NO usa la regla de
    // /splits/{id}/roster/{id}: necesita la suya propia o Firestore la
    // rechaza entera, y la portada se queda cargando para siempre.
    match /{path=**}/roster/{pilotoId} {
      allow read: if true;
    }

    // --- PRIMITIVE HELPERS ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Admin bootstrapping override (Replace with real email logic if necessary)
    function isAdminEmail() {
      return request.auth != null && (request.auth.token.email == 'ajgarciarias@gmail.com' || request.auth.token.email == 'admin@f1bugambra.com');
    }

    // Checking if user is admin from their profile, or via bootstrap email
    function isAdmin() {
      return isSignedIn() && (isAdminEmail() || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'));
    }

    function isJeque() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'jeque';
    }

    function isJequeAfter() {
      return isSignedIn() && existsAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'jeque';
    }
    
    // --- VALIDATION BLUEPRINTS ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'nombre', 'email', 'rol']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.nombre is string && data.nombre.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.rol is string && data.rol.matches('^(admin|usuario|invitado|jeque|piloto)$');
      // Financials and stats are optional or initialized to baseline values.
    }

    function isValidEscuderia(data) {
      return data.keys().hasAll(['nombre', 'presupuesto', 'jeque_id']) &&
             data.nombre is string && data.nombre.size() <= 100 &&
             data.presupuesto is number &&
             data.jeque_id is string && data.jeque_id.size() <= 128;
    }

    function isValidSplit(data) {
      return data.keys().hasAll(['nombre']) &&
             data.nombre is string && data.nombre.size() <= 100;
    }

    function isValidCircuito(data) {
      return data.keys().hasAll(['nombre', 'completado', 'resultados']) &&
             data.nombre is string && data.nombre.size() <= 100 &&
             data.completado is bool &&
             data.resultados is list && data.resultados.size() <= 12; // 12 drivers max
    }

    // --- COLLECTION RULES ---

    // 1. Usuarios Collection
    match /usuarios/{userId} {
      allow read: if true; // Public for album
      
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().rol == 'usuario' &&
          incoming().email == request.auth.token.email &&
          incoming().auth_email == request.auth.token.email &&
          getAfter(/databases/$(database)/documents/auth_emails/$(request.auth.token.email)).data.uid == userId
        )
      );
      
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['foto_url', 'nombre']))
      );
      
      allow delete: if isAdmin();
    }

    // Deterministic normalized-email ownership prevents duplicate app profiles.
    match /auth_emails/{emailId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        emailId == request.auth.token.email &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().auth_email == request.auth.token.email &&
        (!exists(/databases/$(database)/documents/auth_emails/$(emailId)) || existing().uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /plantilla/{docId} {
      allow read: if true;
      allow delete: if isSignedIn();  // Allow deleting when taking the slot
      allow write: if isAdmin();
    }

    // 2. Escuderias Collection
    match /escuderias/{escuderiaId} {
      allow get: if isSignedIn() && isValidId(escuderiaId) && (isAdmin() || isJeque());
      allow list: if isSignedIn() && (isAdmin() || isJeque());
      allow create: if isAdmin() && isValidId(escuderiaId) && isValidEscuderia(incoming());
      // Allow Jeque update for jeque_id when claiming, or admin
      allow update: if isSignedIn() && isValidId(escuderiaId);
      allow delete: if isAdmin() && isValidId(escuderiaId);
    }

    // Global pilotos collection (flat model)
    match /pilotos/{pilotoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Muro del paddock: cualquiera puede leerlo (incluidos invitados), y cualquier usuario
    // firmado puede publicar en su propio nombre. Sin update: los posts no se editan.
    match /paddock_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Rumores y anuncios del mercado: los publica el admin, los lee todo el mundo (incluidos
    // invitados en modo lectura).
    match /market_posts/{postId} {
      allow read: if true;
      allow create, delete: if isAdmin();
    }

    // Entrevistas de FOM: vídeos de YouTube que el admin engancha a mano. Lectura pública.
    match /fom_interviews/{interviewId} {
      allow read: if true;
      allow create, delete: if isAdmin();
    }

    // 3. Splits Collection
    match /splits/{splitId} {
      allow read: if true; // Public for guest mode
      allow create: if isAdmin() && isValidId(splitId);
      allow update: if isSignedIn() && isValidId(splitId) && isAdmin();
      allow delete: if isAdmin() && isValidId(splitId);

      // 3.1. Circuitos Sub-collection
      match /circuitos/{circuitoId} {
        allow read: if true;
        allow create: if isAdmin() && isValidId(circuitoId);
        // Cualquier cuenta de la liga puede votar al piloto del día, pero solo tocando ese
        // campo — el resto del circuito (resultados, actas, economía) sigue siendo solo admin.
        allow update: if isSignedIn() && isValidId(circuitoId) && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['piloto_dia_votantes'])
        );
        allow delete: if isAdmin() && isValidId(circuitoId);
      }

      // 3.2. Equipos Sub-collection
      match /equipos/{teamId} {
        allow read: if true;
        allow create: if isAdmin() && isValidId(teamId);
        allow update: if isSignedIn() && isValidId(teamId) && (isAdmin() || isJeque() || isJequeAfter());
        allow delete: if isAdmin() && isValidId(teamId);

        // 3.3. Pilotos Sub-collection (modelo antiguo)
        match /pilotos/{pilotId} {
          allow read: if true;
          allow create, update, delete: if isSignedIn() && isValidId(pilotId) && (isAdmin() || isJeque());
        }
      }

      // 3.4. Roster Sub-collection (modelo plano nuevo)
      match /roster/{pilotoId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && isValidId(pilotoId) && (isAdmin() || isJeque());
      }

      // 3.5. Subasta en vivo. La sala la abre y la adjudica el admin; los jeques solo
      // pueden mover la puja, y el resto de la liga la ve en directo.
      match /subasta/{salaId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isSignedIn() && (
          isAdmin() ||
          (isJeque() && incoming().diff(existing()).affectedKeys()
            .hasOnly(['estado', 'puja_actual', 'puja_equipo_id', 'puja_equipo_nombre',
                      'termina_en', 'prorrogada', 'actualizado_en']))
        );

        // El historial de pujas es solo añadir: nadie reescribe lo que ya pujó.
        match /pujas/{pujaId} {
          allow read: if true;
          allow create: if isSignedIn() && (isAdmin() || isJeque());
          allow update: if false;
          allow delete: if isAdmin();
        }
      }

      // 3.4. Notificaciones / Historial de Fichajes Sub-collection
      match /transfers/{transferId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (isAdmin() || isJeque());
      }
    }

    // 4. Mejoras Collection (Buzon de Sugerencias)
    match /mejoras/{mejoraId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(mejoraId);
      allow update: if isSignedIn() && isValidId(mejoraId) && (
        isAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['votos'])
      );
      allow delete: if isAdmin() && isValidId(mejoraId);
    }
  }
}
