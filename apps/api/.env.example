PORT=4000
DATABASE_URL=postgresql://f1_bugambra:change_me@127.0.0.1:5432/f1_bugambra
FIREBASE_PROJECT_ID=your-firebase-project-id
CORS_ORIGIN=http://localhost:3000

# Optional: enables admin-only race-winner image generation. Keep this secret
# in the API process environment; never add it to the web app's Vite variables.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Firebase Admin uses Application Default Credentials. On the server, point this
# to a service-account JSON file readable only by the API process.
GOOGLE_APPLICATION_CREDENTIALS=/etc/f1-bugambra/firebase-service-account.json
