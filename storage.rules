rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Cualquiera puede leer imágenes (logos y fotos son públicas en la app)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Logos de escuderías: solo admins pueden subir/borrar
    match /logos/{splitId}/{teamId} {
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024   // max 2 MB
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de pilotos: admin puede subir cualquiera; cada usuario solo la suya
    match /fotos/pilotos/{pilotoId} {
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
